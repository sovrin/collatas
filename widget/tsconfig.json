{
  // The form component runs in other sites' pages: browser globals only, no Nuxt.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // shared/contracts builds on the core's rules; the form takes only types from it.
    "paths": { "#nexitas/*": ["../../nexitas/*"] }
  },
  "include": ["./*.ts"]
}
