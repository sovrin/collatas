# Generate once: openssl rand -hex 32
COLLATAS_BOOTSTRAP_TOKEN=

# The address people open collatas at; the admin only accepts writes from here.
# COLLATAS_ORIGIN=https://collatas.example.com

# Where the web service listens on the host (loopback by default; your proxy reaches it there or
# over a network added in compose.override.yaml).
# COLLATAS_BIND=127.0.0.1:3000
